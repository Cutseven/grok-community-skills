{
  "description": "Grok edition exclusive: ask before shell commands that delete, overwrite, force-push or send",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/confirm-destructive.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
